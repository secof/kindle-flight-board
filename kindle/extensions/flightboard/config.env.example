# ==============================================================================
# Kindle Flight Board Configuration (FW 5.17 / Winterbreak)
# ==============================================================================

# URL of your Unraid / Docker server backend running the flight board server
# REPLACE THIS WITH YOUR ACTUAL UNRAID / DOCKER SERVER IP!
SERVER_URL="http://192.168.1.100:8000"

# Polling interval in seconds (default: 60)
POLL_INTERVAL=60

# Set to 1 to enable Wi-Fi toggling (turn Wi-Fi on for update, then off to save battery)
TOGGLE_WIFI=0

# Image rotation (90 for 90-degree left rotation on Kindle screen, 270 for right)
ROTATE=90

# Set to 1 to stop Kindle native framework (clears 'From your library' home screen)
STOP_FRAMEWORK=1
